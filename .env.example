# ════════════════════════════════════════════════════════════
# RETROUVEMOI — CONFIGURATION (COPIE ANONYMISÉE)
# Copiez ce fichier en `.env` puis remplacez chaque valeur
# par vos informations réelles. Ne commitez jamais votre `.env`.
# ════════════════════════════════════════════════════════════

# ── MySQL (Prisma) ───────────────────────────────────────────
# Format : mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BDD
# Exemple local (XAMPP/WAMP) : mysql://root:@127.0.0.1:3306/objet_trouver
DATABASE_URL="mysql://VOTRE_UTILISATEUR:VOTRE_MOT_DE_PASSE@127.0.0.1:3306/VOTRE_BDD"

# ── Better Auth (authentification) ──────────────────────────
# SECRET : générez-en un long, ex. : openssl rand -base64 32
BETTER_AUTH_SECRET="GENERER_UN_SECRET_LONG_ET_UNIQUE"
# URL de base de l'application (dév : http://localhost:3000)
BETTER_AUTH_URL="http://localhost:3000"
# Clé admin Better Auth (protégez-la, elle donne des droits admin)
BETTER_AUTH_ADMIN_KEY="GENERER_UNE_AUTRE_CLE_UNIQUE"

# ── Cloudinary (upload images : logos, photos objets) ────────
CLOUDINARY_CLOUD_NAME="VOTRE_CLOUD_NAME"
CLOUDINARY_API_KEY="VOTRE_API_KEY"
CLOUDINARY_API_SECRET="VOTRE_API_SECRET"
CLOUDINARY_UPLOAD_FOLDER="objet-trouver"

# ── Next.js ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# App ID OneSignal (notifications push) — facultatif
NEXT_PUBLIC_ONESIGNAL_APP_ID="VOTRE_ONESIGNAL_APP_ID"
NEXT_PUBLIC_APP_NAME=RetrouveMoi

# ════════════════════════════════════════════════════════════
# SERVICES TIERS (paiements, notifications)
# ════════════════════════════════════════════════════════════
VITE_APP_NAME=RetrouveMoi
VITE_APP_TAGLINE=La restitution citoyenne

# ── MoneyFusion (paiements : dons, abonnements, mises en avant) ──
# Remplacez par l'URL et la clé fournies par MoneyFusion pour VOTRE compte marchand
VITE_MONEFUSION_URL="https://URL_DE_VOTRE_PARAMETRE_MONEFUSION"
VITE_MONEFUSION_API_KEY="VOTRE_CLE_API_MONEFUSION"

# ── OneSignal (serveur) ──────────────────────────────────────
ONESIGNAL_APP_ID="VOTRE_ONESIGNAL_APP_ID"
ONESIGNAL_REST_API_KEY="VOTRE_CLE_REST_ONESIGNAL"